# --- PostgreSQL (localhost:5434) ---
# Koneksi app: role 'wutuh' dengan RLS AKTIF (dipakai semua request user)
DATABASE_URL=postgres://wutuh:wutuh@localhost:5434/wutuh
# Koneksi admin: superuser 'postgres' / BYPASSRLS (HANYA create db, migrasi, RLS setup, seed)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5434/wutuh

# --- Auth ---
JWT_SECRET=ganti_dengan_secret_acak_panjang
JWT_ACCESS_TTL=28800

# --- WhatsApp gateway (opsional) ---
# Bila diisi, API otomatis mengirim WA: ke PEMBELI di tiap perubahan status pesanan,
# dan ke PENJUAL saat ada pesanan baru dari Pasar WUTUH.
# Format gateway gaya Fonnte/Wablas: POST {target, message}, header Authorization=token.
# Kosongkan untuk memakai tombol "Buka WhatsApp" manual di UI (tanpa biaya).
# WA_GATEWAY_URL=https://api.fonnte.com/send
# WA_GATEWAY_TOKEN=token_gateway_anda

# --- App ---
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174
